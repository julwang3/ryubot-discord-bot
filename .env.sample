# Copy this file to ".env" and fill in the values below.

# Your bot's token, from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Your bot's Application ID, from the "General Information" tab of the same page
CLIENT_ID=

# Optional: a Discord server (guild) ID for instant command updates during development.
# Right-click your server icon in Discord (with Developer Mode on) -> Copy Server ID.
# Leave blank to register commands globally (takes up to ~1 hour to propagate, but works everywhere).
GUILD_ID=
